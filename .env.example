# 모델 제공자. 다섯 중 키가 있는 것만 쓸 수 있다.
# 키가 없는 제공자는 그 기능만 실패하고, 조용히 다른 제공자로 넘어가지 않는다
# — .claude/rules/llm.md
#
# 값은 이 파일에 적지 않는다. 이름만 문서화한다.
# 모델 이름을 비워 두면 app/config.py 의 기본값을 쓴다. 빈 문자열은 값으로 치지 않는다.
GEMINI_API_KEY=
GEMINI_MODEL=

CLAUDE_API_KEY=
CLAUDE_MODEL=

GPT_API_KEY=
GPT_MODEL=

# Qwen 은 OpenAI 호환 엔드포인트로 부른다.
# 모델을 별칭(qwen-turbo, qwen-plus, qwen-flash)으로 두지 않는다 — 별칭은 응답을 스키마로
# 강제하지 못해 본문 분류에 쓸 수 없다.
# QWEN_BASE_URL 은 워크스페이스 전용 도메인으로 옮길 때만 적는다
QWEN_API_KEY=
QWEN_MODEL=
QWEN_BASE_URL=

# Ollama Cloud 도 OpenAI 호환 엔드포인트로 부른다 (https://ollama.com/v1).
# 본문 분류에는 쓸 수 없다 — 클라우드가 구조화 출력을 지원하지 않아 판정 칸의 닫힌 목록을
# 보장하지 못한다. 셀렉터 생성과 AI 수정에는 쓸 수 있다.
# 모델 목록은 자주 바뀐다. 지금 있는 것은 화면에서 고르거나 /v1/models 로 확인한다
OLLAMA_API_KEY=
OLLAMA_MODEL=
OLLAMA_BASE_URL=

# 기능마다 어느 제공자를 쓰는지. 값은 gemini / claude / gpt / qwen / ollama 중 하나다.
# 비워 두면 gemini 를 쓴다. 분류가 비용의 대부분이라 여기만 싼 제공자로 두는 선택이 된다
SELECTOR_GENERATE_PROVIDER=
SELECTOR_REPAIR_PROVIDER=
CLASSIFY_PROVIDER=

# 저장
DATABASE_PATH=./data/jobs.db

# 크롤링. 값은 보수적으로 둔다 — .claude/rules/crawling.md
CRAWL_USER_AGENT=job-crawler-automation (contact: 연락받을-주소@example.com)
CRAWL_DELAY_SECONDS=3
CRAWL_TIMEOUT_SECONDS=20
CRAWL_MAX_RETRIES=3
# Playwright 렌더 1회의 상한. render_mode=playwright 인 크롤러에만 쓰인다
RENDER_TIMEOUT_SECONDS=60

# 화면
# 화면에 시각을 그릴 때 쓰는 시간대. 저장된 값은 UTC 그대로다.
# 제공 API 의 normalized_at 은 이 값과 무관하게 UTC 로 나간다
DISPLAY_TIMEZONE=Asia/Seoul

# 운영 화면 잠금
# 화면과 API 를 여는 비밀번호 하나다. 계정도 권한도 없다.
# 설정하지 않으면 기본값으로 뜨고, 그때는 화면과 기동 로그가 그렇다고 알린다.
# 공개 주소에 올린다면 반드시 설정한다 — 기본값은 잠기지 않은 것과 같다.
# 아래 줄의 주석을 풀고 값을 넣는다. 값은 이 파일에 적지 않는다.
#ADMIN_PASSWORD=

# 실행
# MAX_CONCURRENT_RUNS 는 app_settings 에 값이 없을 때 넣어 주는 초기값이다.
# 한 번 들어간 뒤로는 어드민에서 바꾸는 DB 값이 이긴다 — .claude/docs/architecture.md
MAX_CONCURRENT_RUNS=3
# FIRST_RUN_LIMIT 도 같은 방식이다. 워크플로우 첫 실행이 담을 항목 수의 상한이고,
# 0 은 상한 없음이다. 등록하면 목록에 걸린 과거 공고가 통째로 들어오는 것을 막는다
FIRST_RUN_LIMIT=20
RUN_TIMEOUT_SECONDS=600
