    },
    "fields": {
      "title": "data.jobNoticesDetail.jobNoticesDetail.jobNoticeName",
      "body": "data.jobNoticesDetail.recList.0.detailContext",
      "qualifications": "data.jobNoticesDetail.recList.0.requiredItem",
      "recruitment_end_at": "data.jobNoticesDetail.jobNoticesDetail.recEndDate",
